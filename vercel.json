{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/docs-angular/browser",
  "redirects": [
    { "source": "/", "destination": "/instalacion", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.csr.html" }
  ]
}
